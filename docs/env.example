SERVER_HOST=0.0.0.0:3000

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 嵌入模型配置
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-ada-002

# Agent配置
# 温度 0.1-0.3 准确性高，0.5-0.7 创造性高
TEMPERATURE=0.5
PREAMBLE_FILE=data/preamble.md
PREAMBLE_SECRET_KEY=aaa111===
# RAG 每次检索注入的切片数（默认 5；过大导致慢/费 token）
RAG_TOP_K=5

# 本地 markdown 知识库目录
DOCUMENTS_DIR=data/documents
# 排除子目录（逗号分隔）
DOCUMENTS_EXCLUDE_DIRS=en,vi
# 目录变更检测间隔（秒，最小 5，默认 30）
DOCUMENTS_SYNC_INTERVAL_SECS=30


# Qdrant配置
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=rig_documents
QDRANT_DISTANCE=Cosine
# 如使用云端或受保护实例，提供API Key
QDRANT_API_KEY=

# 文件备份配置
BACKUP_DIR=data/backups

# 用户数据库配置（SQLite）
# mode=rwc: 读写模式，如果不存在则创建
USER_DB_PATH=sqlite:data/users.db?mode=rwc
# JWT配置（必须设置，且不能用占位值；建议: openssl rand -hex 32）
JWT_SECRET=replace-with-openssl-rand-hex-32-output
# 默认管理员密码（仅首次启动时使用）
DEFAULT_ADMIN_PASSWORD=admin123
# 对话数据库配置（SQLite）
CONVERSATION_DB_PATH=sqlite:data/conversations.db?mode=rwc